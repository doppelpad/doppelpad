{
  "name": "doppelpad-gui",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src scripts index.html overlay.html vite.config.ts",
    "format:check": "prettier --check src scripts index.html overlay.html vite.config.ts",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "drawings": "node src/assets/devices/generate.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/svelte": "^1.59.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/svelte": "^5.0.8",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
