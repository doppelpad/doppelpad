{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doppelpad",
  "identifier": "dev.doppelpad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/third-party-licenses.mjs --check && node scripts/fetch-drivers.mjs && node scripts/stage-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Doppelpad",
        "width": 1320,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#0f1115",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Doppelpad contributors",
    "copyright": "Copyright (c) 2026 The Doppelpad contributors",
    "homepage": "https://github.com/doppelpad/doppelpad",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["dpgame"],
        "name": "Doppelpad game",
        "description": "Doppelpad game",
        "role": "Editor",
        "mimeType": "application/x-doppelpad-game"
      }
    ],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["English", "German"]
      }
    }
  }
}
