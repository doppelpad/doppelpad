{
  "name": "Round trip",
  "description": "Every shape the editor writes",
  "processes": ["game.exe"],
  "output": { "virtual_pad": "none", "hide_physical": true, "passthrough": false, "mute_mapped_inputs": true },
  "timing": { "long_press_ms": 400, "double_tap_ms": 250, "triple_tap_ms": 250, "key_delay_ms": 20, "turbo_ms": 80, "combo_window_ms": 60 },
  "sticks": {
    "left": {
      "deadzone": 0.08,
      "outer": 0.95,
      "anti_deadzone": 0.15,
      "sensitivity": 1.2,
      "curve": [],
      "invert_x": false,
      "invert_y": true,
      "rotation": 45,
      "zones": { "low": [0.25, 0.375], "high": 0.75 }
    },
    "right": {
      "deadzone": 0.06,
      "outer": 1,
      "anti_deadzone": 0,
      "sensitivity": 1,
      "curve": [[0.3, 0.15], [0.7, 0.55]],
      "invert_x": false,
      "invert_y": false,
      "rotation": 0,
      "zones": { "low": 0.25 }
    }
  },
  "triggers": {
    "left": { "deadzone": 0.05, "zones": { "low": 0.0625 }, "full_pull": 0.9 },
    "right": { "deadzone": 0, "zones": { "low": 0.125, "med": 0.5 }, "full_pull": 0.875 }
  },
  "layers": [
    { "id": 1, "name": "Aim", "inherit": true },
    { "id": 2, "inherit": false, "not_inherited": ["B", ["LB", "RB"]] }
  ],
  "mappings": [
    { "trigger": "A", "actions": [{ "key": "Space" }] },
    { "trigger": "B", "activator": "long", "actions": [{ "key": "LeftCtrl" }, { "key": "C" }], "long_press_ms": 600 },
    { "trigger": "X", "mode": "turbo", "turbo_ms": 50, "actions": [{ "mouse": "left" }] },
    { "trigger": "Y", "mode": "toggle", "actions": [{ "pad": "A" }] },
    { "trigger": "LB", "jump": { "layer": 1, "mode": "hold" } },
    { "trigger": "RB", "jump": { "layer": 2, "mode": "switch", "delay_ms": 200 }, "description": "Swap weapons" },
    { "trigger": ["LB", "RB"], "actions": [{ "key": "Tab" }] },
    { "trigger": "Back", "activator": "double", "actions": [{ "command": "remap_off" }] },
    { "trigger": "Start", "activator": "release", "actions": [{ "command": { "launch": { "path": "C:\\Tools\\app.exe", "args": "" } } }] },
    { "trigger": "Guide", "activator": "triple", "actions": [{ "command": "toggle_gyro" }] },
    {
      "trigger": "DpadUp",
      "mode": "repeat",
      "repeat": 3,
      "repeat_pause_ms": 100,
      "key_delay_ms": 30,
      "actions": [
        { "key": "E", "action": "down" },
        { "pause": 50 },
        { "key": "E", "action": "up" },
        { "rumble": 120, "low": 0.5, "high": 0.25 }
      ]
    },
    { "trigger": "DpadDown", "actions": [{ "wheel": "down" }, { "mouse_move": "left", "speed": 800 }] },
    { "trigger": "LeftStickUp", "actions": [{ "stick": "right", "x": 0, "y": 1 }] },
    { "trigger": "LT", "activator": "start", "actions": [{ "trigger": "right" }] },
    { "trigger": "RTHigh", "actions": [{ "key": "LeftShift" }] },
    { "trigger": "LeftStickUpLow", "activator": "long", "actions": [{ "key": "W" }] },
    { "trigger": "RightStickMed", "mode": "turbo", "actions": [{ "mouse": "right" }] },
    { "trigger": ["LB", "LTMed"], "actions": [{ "key": "G" }] },
    { "layer": 1, "trigger": "A", "mode": "once", "actions": [{ "key": "F" }] },
    { "layer": 1, "trigger": "PaddleUL" },
    { "layer": 2, "trigger": "Key:Q", "mode": "while_held", "actions": [{ "mouse": "x1" }] }
  ],
  "analog": [
    {
      "layer": 0,
      "source": "right_stick",
      "target": "mouse",
      "sensitivity": 1.2,
      "vertical_ratio": 0.8,
      "curve": 1.8,
      "invert_x": false,
      "invert_y": false,
      "deadzone": 0.12,
      "anti_deadzone": 0,
      "smoothing_ms": 10,
      "decay_ms": 40,
      "trackball_friction": 0,
      "while_held": [],
      "consume": true
    },
    {
      "layer": 1,
      "source": "gyro",
      "target": "right_stick",
      "sensitivity": 2.5,
      "vertical_ratio": 1,
      "curve": 1,
      "invert_x": false,
      "invert_y": true,
      "deadzone": 0.1,
      "anti_deadzone": 0.2,
      "smoothing_ms": 0,
      "decay_ms": 40,
      "trackball_friction": 0,
      "while_held": ["LT"],
      "consume": false
    },
    {
      "layer": 2,
      "source": "mouse",
      "target": "left_stick",
      "sensitivity": 1.5,
      "vertical_ratio": 1,
      "curve": 1,
      "invert_x": true,
      "invert_y": false,
      "deadzone": 0.1,
      "anti_deadzone": 0.2,
      "smoothing_ms": 8,
      "decay_ms": 60,
      "trackball_friction": 0,
      "while_held": ["LB", "Mouse:Right"],
      "consume": true
    },
    {
      "layer": 0,
      "source": "touchpad",
      "target": "mouse",
      "sensitivity": 1,
      "vertical_ratio": 1,
      "curve": 1,
      "invert_x": false,
      "invert_y": false,
      "deadzone": 0.1,
      "anti_deadzone": 0,
      "smoothing_ms": 0,
      "decay_ms": 40,
      "trackball_friction": 0.5,
      "while_held": [],
      "consume": true
    }
  ]
}
